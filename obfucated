MiscSection:createButton({
	text = "Steal Nearest Car",
	callback = function()
		local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid")
		local hrp = character:WaitForChild("HumanoidRootPart")

		local function getNearestFreeSeat()
			local civCars = workspace:FindFirstChild("CivCars")
			if not civCars then return nil end
			local closestSeat, shortestDistance = nil, math.huge
			for _, obj in ipairs(civCars:GetDescendants()) do
				if obj:IsA("VehicleSeat") and obj.Occupant == nil then
					local distance = (obj.Position - hrp.Position).Magnitude
					if distance < shortestDistance then shortestDistance = distance closestSeat = obj end
				end
			end
			return closestSeat
		end

		local function zeroVehicleVelocities(vehicle)
			if not vehicle or not vehicle.Parent then return end
			for _, part in ipairs(vehicle:GetDescendants()) do
				if part:IsA("BasePart") then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end

		local function stealCar(seat)
			if not seat or not seat:IsDescendantOf(workspace) or seat.Occupant then return false end
			local vehicle = seat.Parent
			hrp.CanCollide = false
			seat.CanCollide = false
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			zeroVehicleVelocities(vehicle)
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
			task.wait(0.05)
			hrp.CFrame = seat.CFrame
			local sitAttempts = 0
			while sitAttempts < 5 do
				sitAttempts += 1
				pcall(function() seat:Sit(humanoid) end)
				task.wait(0.03)
				if humanoid.SeatPart == seat then break end
			end
			hrp.CanCollide = true
			seat.CanCollide = true
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
			zeroVehicleVelocities(vehicle)
			return humanoid.SeatPart == seat
		end

		local seat = getNearestFreeSeat()
		if seat then
			local success = stealCar(seat)
			Library:notify({ title = "Steal Car", text = success and "Successfully Stolen" or "Failed. Try again", scaleX = 0.165, sizeY = 200 })
		else
			Library:notify({ title = "Steal Car", text = "No cars nearby", scaleX = 0.165, sizeY = 200 })
		end
	end
})

