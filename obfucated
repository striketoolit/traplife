runService.RenderStepped:Connect(function()
	currentCamera = workspace.CurrentCamera
	local center = getScreenCenter()

	FOVCircle.Position = center
	FOVCircle.Visible = AimbotConfig.Enabled and AimbotConfig.FOVEnabled

	if not AimbotConfig.Enabled then
		holding = false
		lockedTarget = nil
		Snapline.Visible = false
		wasHolding = false
		return
	end

	local justPressed = holding and not wasHolding
	wasHolding = holding

	if justPressed then
		lockedTarget = getClosestTarget()
	end

	if not isTargetValid(lockedTarget) then
		lockedTarget = nil
	end

	if holding and lockedTarget then
		local part = getTargetPart(lockedTarget.Character)
		if part then
			local screenPos, onScreen = currentCamera:WorldToViewportPoint(part.Position)
			if onScreen then
				local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
				local delta = screenPos2D - center
				local factor = math.clamp(AimbotConfig.Smoothness / 10, 0.01, 1)
				if AimbotConfig.Method == "Mouse" then
					mousemoverel(delta.X * factor, delta.Y * factor)
				else
					local targetCFrame = CFrame.new(currentCamera.CFrame.Position, part.Position)
					currentCamera.CFrame = currentCamera.CFrame:Lerp(targetCFrame, factor)
				end
			end
		end
	end

	local displayTarget = isTargetValid(lockedTarget) and lockedTarget or getClosestTarget()

	if AimbotConfig.SnaplineEnabled and displayTarget and displayTarget.Character then
		local part = getTargetPart(displayTarget.Character)
		if part then
			local screenPos, onScreen = currentCamera:WorldToViewportPoint(part.Position)
			if onScreen then
				Snapline.From = Vector2.new(center.X, currentCamera.ViewportSize.Y)
				Snapline.To = Vector2.new(screenPos.X, screenPos.Y)
				Snapline.Visible = true
			else
				Snapline.Visible = false
			end
		else
			Snapline.Visible = false
		end
	else
		Snapline.Visible = false
	end
end)

