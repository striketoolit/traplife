local CarFly = { Enabled = false, Speed = 150, Direction = Vector3.zero, BV = nil, BG = nil, Connections = {} }

local function bindCarFlyInputs()
	table.insert(CarFly.Connections, userInputService.InputBegan:Connect(function(input, gp)
		if gp or not CarFly.Enabled then return end
		if input.KeyCode == Enum.KeyCode.W then CarFly.Direction += Vector3.new(0,0,1)
		elseif input.KeyCode == Enum.KeyCode.S then CarFly.Direction += Vector3.new(0,0,-1)
		elseif input.KeyCode == Enum.KeyCode.A then CarFly.Direction += Vector3.new(-1,0,0)
		elseif input.KeyCode == Enum.KeyCode.D then CarFly.Direction += Vector3.new(1,0,0)
		elseif input.KeyCode == Enum.KeyCode.Space then CarFly.Direction += Vector3.new(0,1,0)
		elseif input.KeyCode == Enum.KeyCode.LeftShift then CarFly.Direction += Vector3.new(0,-1,0) end
	end))
	table.insert(CarFly.Connections, userInputService.InputEnded:Connect(function(input)
		if not CarFly.Enabled then return end
		if input.KeyCode == Enum.KeyCode.W then CarFly.Direction -= Vector3.new(0,0,1)
		elseif input.KeyCode == Enum.KeyCode.S then CarFly.Direction -= Vector3.new(0,0,-1)
		elseif input.KeyCode == Enum.KeyCode.A then CarFly.Direction -= Vector3.new(-1,0,0)
		elseif input.KeyCode == Enum.KeyCode.D then CarFly.Direction -= Vector3.new(1,0,0)
		elseif input.KeyCode == Enum.KeyCode.Space then CarFly.Direction -= Vector3.new(0,1,0)
		elseif input.KeyCode == Enum.KeyCode.LeftShift then CarFly.Direction -= Vector3.new(0,-1,0) end
	end))
end

local function enableCarFly()
	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	CarFly.Enabled = true CarFly.Direction = Vector3.zero
	bindCarFlyInputs()
	CarFly.BV = Instance.new("BodyVelocity")
	CarFly.BV.MaxForce = Vector3.new(1e9,1e9,1e9) CarFly.BV.Velocity = Vector3.zero CarFly.BV.Parent = hrp
	CarFly.BG = Instance.new("BodyGyro")
	CarFly.BG.MaxTorque = Vector3.new(1e9,1e9,1e9) CarFly.BG.P = 30000 CarFly.BG.D = 200
	CarFly.BG.CFrame = hrp.CFrame CarFly.BG.Parent = hrp
	table.insert(CarFly.Connections, runService.Heartbeat:Connect(function()
		if not CarFly.Enabled then return end
		local cam = workspace.CurrentCamera
		CarFly.BG.CFrame = cam.CFrame
		local move = Vector3.zero
		if CarFly.Direction.Magnitude > 0 then
			move = cam.CFrame.LookVector * CarFly.Direction.Z + cam.CFrame.RightVector * CarFly.Direction.X + Vector3.new(0, CarFly.Direction.Y, 0)
			move = move.Unit * CarFly.Speed
		end
		CarFly.BV.Velocity = move
	end))
end

local function disableCarFly()
	CarFly.Enabled = false CarFly.Direction = Vector3.zero
	for _, c in pairs(CarFly.Connections) do c:Disconnect() end
	CarFly.Connections = {}
	if CarFly.BV then CarFly.BV:Destroy() CarFly.BV = nil end
	if CarFly.BG then CarFly.BG:Destroy() CarFly.BG = nil end
end

