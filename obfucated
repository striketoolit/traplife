runService.RenderStepped:Connect(function()
	if not ESPConfig.Master then
		clearAllESP()
		return
	end

	for _, player in pairs(playersService:GetPlayers()) do
		if player == localPlayer then continue end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")

		if not (char and hum and hrp and hum.Health > 0) then
			clearESP(player)
			continue
		end

		if not ESPConfig.Cache[player] then
			createESP(player)
		end

		local cache = ESPConfig.Cache[player]
		local tl, br = getBoxBounds(char)

		if not tl or not br then
			hideESP(cache)
			continue
		end

		local size = br - tl
		local centerX = (tl.X + br.X) / 2
		local dist = math.floor((currentCamera.CFrame.Position - hrp.Position).Magnitude)
		local labelY = tl.Y - 16
		local weapon = getEquippedWeapon(char)

		cache.Box.Visible = ESPConfig.Box
		cache.Box.Position = tl
		cache.Box.Size = size

		cache.Fill.Visible = ESPConfig.BoxFilled
		cache.Fill.Position = tl
		cache.Fill.Size = size

		if ESPConfig.Name then
			cache.Name.Visible = true
			cache.Name.Text = player.DisplayName
			cache.Name.Position = Vector2.new(centerX, labelY)
			labelY = labelY - 16
		else
			cache.Name.Visible = false
		end

		if ESPConfig.Health then
			local pct = math.floor((hum.Health / hum.MaxHealth) * 100)
			local r = 1 - (pct / 100)
			local g = pct / 100
			cache.Health.Visible = true
			cache.Health.Text = pct .. "%"
			cache.Health.Color = Color3.new(r, g, 0)
			cache.Health.Position = Vector2.new(centerX, labelY)
			labelY = labelY - 16
		else
			cache.Health.Visible = false
		end

		if ESPConfig.Distance then
			cache.Distance.Visible = true
			cache.Distance.Text = dist .. "m"
			cache.Distance.Position = Vector2.new(centerX, br.Y + 4)
		else
			cache.Distance.Visible = false
		end

		if ESPConfig.Weapon and weapon then
			cache.Weapon.Visible = true
			cache.Weapon.Text = weapon
			cache.Weapon.Position = Vector2.new(centerX, br.Y + (ESPConfig.Distance and 18 or 4))
		else
			cache.Weapon.Visible = false
		end

		if ESPConfig.Skeleton then
			for i, joint in ipairs(Joints) do
				local p0 = char:FindFirstChild(joint[1])
				local p1 = char:FindFirstChild(joint[2])
				local line = cache.Skeleton[i]
				if p0 and p1 then
					local a, v1 = currentCamera:WorldToViewportPoint(p0.Position)
					local b, v2 = currentCamera:WorldToViewportPoint(p1.Position)
					if v1 and v2 then
						line.From = Vector2.new(a.X, a.Y)
						line.To = Vector2.new(b.X, b.Y)
						line.Visible = true
					else
						line.Visible = false
					end
				else
					line.Visible = false
				end
			end
		else
			for _, line in pairs(cache.Skeleton) do
				line.Visible = false
			end
		end
	end
end)

