local SpinSection = MovementPage:createSection({ text = "Spinbot", position = "Left" })

do
	local spinning = false
	local spinSpeed = 0
	local spinThread = nil

	local function startSpinning()
		local hrp = (localPlayer.Character or localPlayer.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
		while spinning do
			pcall(function() hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinSpeed / 60), 0) end)
			runService.Heartbeat:Wait()
		end
	end

	SpinSection:createToggle({
		text = "Spin",
		state = false,
		callback = function(Value)
			spinning = Value
			if spinning then
				if spinThread then pcall(coroutine.close, spinThread) end
				spinThread = coroutine.create(startSpinning)
				coroutine.resume(spinThread)
			end
		end
	})

	SpinSection:createSlider({
		text = "Spin Speed",
		min = 0,
		max = 2000,
		step = 1,
		callback = function(value) spinSpeed = value end
	})
end

