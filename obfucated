local function resetJumpDebounces()
	for _, fn in ipairs(getgc(false)) do
		if not islclosure(fn) or isexecutorclosure(fn) then continue end
		local ok, src = pcall(debug.info, fn, "s")
		if not ok or not src then continue end
		if not string.find(string.lower(src), "jump") then continue end
		local ups = getupvalues(fn)
		for i, v in ipairs(ups) do
			if type(v) == "boolean" and v == true then
				pcall(debug.setupvalue, fn, i, false)
			end
		end
	end
end

