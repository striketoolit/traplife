LocalSection:createToggle({
	text = "Auto Loot Bags",
	state = false,
	callback = function(Value)
		local Storage = workspace:FindFirstChild("Storage")
		getgenv().AutoLootBags = Value
		local OriginalPosition = nil

		local function TeleportToPosition(position)
			local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
			local humanoid = character and character:WaitForChild("Humanoid")
			local rootPart = character and character:WaitForChild("HumanoidRootPart")
			if not rootPart or not humanoid then return end
			humanoid:ChangeState(0)
			repeat task.wait() until not localPlayer:GetAttribute("LastACPos")
			rootPart.CFrame = CFrame.new(position, position + Vector3.new(0, 0, -1))
			humanoid:ChangeState(8)
		end

		local function StoreCurrentPosition()
			local character = localPlayer.Character
			if character then
				local rootPart = character:FindFirstChild("HumanoidRootPart")
				if rootPart then OriginalPosition = rootPart.Position end
			end
		end

		local function CollectLootBags()
			if not Storage then return end
			local bagsCollected = 0
			for _, item in ipairs(Storage:GetChildren()) do
				if item:IsA("MeshPart") and item.Name == "Baggy" then
					TeleportToPosition(item.Position + Vector3.new(0, 3, 0))
					task.wait(0.2)
					local stealPrompt = item:FindFirstChild("stealprompt")
					if stealPrompt and stealPrompt:IsA("ProximityPrompt") then
						stealPrompt:InputHoldBegin()
						task.wait(0.1)
						stealPrompt:InputHoldEnd()
					end
					bagsCollected = bagsCollected + 1
					task.wait(0.3)
				end
			end
			if bagsCollected == 0 and OriginalPosition then
				TeleportToPosition(OriginalPosition)
				OriginalPosition = nil
			end
		end

		local function CheckAndCollectLoot()
			if not getgenv().AutoLootBags then return end
			local bagsFound = false
			if Storage then
				for _, item in ipairs(Storage:GetChildren()) do
					if item:IsA("MeshPart") and item.Name == "Baggy" then bagsFound = true break end
				end
			end
			if bagsFound then CollectLootBags()
			elseif OriginalPosition then TeleportToPosition(OriginalPosition) OriginalPosition = nil end
		end

		if Value then
			StoreCurrentPosition()
			for _, d in ipairs(workspace:GetDescendants()) do
				if d:IsA("ProximityPrompt") then d.HoldDuration = 0 end
			end
			task.spawn(function()
				while task.wait(0.05) do
					if not getgenv().AutoLootBags then continue end
					CheckAndCollectLoot()
					task.wait(1)
				end
			end)
			Library:notify({ title = "Auto Loot Bags", text = "Auto Loot Bags: ON", scaleX = 0.165, sizeY = 200 })
		else
			for _, d in ipairs(workspace:GetDescendants()) do
				if d:IsA("ProximityPrompt") then d.HoldDuration = 0.5 end
			end
			if OriginalPosition then TeleportToPosition(OriginalPosition) OriginalPosition = nil end
			Library:notify({ title = "Auto Loot Bags", text = "Auto Loot Bags: OFF", scaleX = 0.165, sizeY = 200 })
		end
	end
})

